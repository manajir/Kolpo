{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with language preferences and health state settings",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "currentStage": { "type": "string", "enum": ["menstruating", "pregnancy", "perimenopause", "postmenopause"] },
        "cycleLength": { "type": "integer" },
        "periodLength": { "type": "integer" },
        "lastPeriodDate": { "type": "string" },
        "pregnancyDueDate": { "type": "string" },
        "createdAt": { "type": "string" },
        "subActive": { "type": "boolean" }
      },
      "required": ["uid", "email"]
    },
    "TrackingLog": {
      "title": "TrackingLog",
      "description": "Daily symptoms, moods, and energy tracking logs",
      "type": "object",
      "properties": {
        "logDate": { "type": "string" },
        "periodBleeding": { "type": "string" },
        "cervicalMucus": { "type": "string" },
        "symptoms": { "type": "array" },
        "moods": { "type": "array" },
        "energyLevel": { "type": "string" },
        "notes": { "type": "string" },
        "weight": { "type": "number" },
        "temperature": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["logDate"]
    },
    "ForumPost": {
      "title": "ForumPost",
      "description": "Community forum thread topic and text",
      "type": "object",
      "properties": {
        "postId": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "category": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "createdAt": { "type": "string" },
        "likes": { "type": "array" }
      },
      "required": ["postId", "authorId", "title", "content"]
    },
    "ClinicReport": {
      "title": "ClinicReport",
      "description": "Report generated by the user to share with a clinician",
      "type": "object",
      "properties": {
        "reportId": { "type": "string" },
        "userId": { "type": "string" },
        "createdAt": { "type": "string" },
        "title": { "type": "string" },
        "reportData": { "type": "string" },
        "clinicianAccessCode": { "type": "string" }
      },
      "required": ["reportId", "userId"]
    },
    "UserFile": {
      "title": "UserFile",
      "description": "Metadata of secure files (scans, reports) uploaded by user",
      "type": "object",
      "properties": {
        "fileId": { "type": "string" },
        "fileName": { "type": "string" },
        "fileUrl": { "type": "string" },
        "fileType": { "type": "string" },
        "uploadedAt": { "type": "string" },
        "sizeBytes": { "type": "integer" }
      },
      "required": ["fileId", "fileName", "fileUrl"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "UserProfile",
      "description": "User demographic info, configuration, and state settings"
    },
    "/users/{uid}/tracking/{logDate}": {
      "schema": "TrackingLog",
      "description": "Daily cycle monitoring logs indexed by date"
    },
    "/users/{uid}/files/{fileId}": {
      "schema": "UserFile",
      "description": "Private health reports and scan directories uploaded by the user"
    },
    "/forum/{postId}": {
      "schema": "ForumPost",
      "description": "Globally readable threads for peer support on women's experiences"
    },
    "/users/{uid}/clinic_reports/{reportId}": {
      "schema": "ClinicReport",
      "description": "Secure exports that can be shared with a clinical provider"
    }
  }
}
